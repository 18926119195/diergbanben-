# Copy to .env.local for defaults (UI「模型部署」可覆盖并写入 localStorage).

# OCR / 版面 → A1 文字脸（默认走 Vite /api/zhipu 代理；服务端可配 ZHIPU_API_KEY）
VITE_OCR_API_KEY=
VITE_OCR_BASE_URL=/api/zhipu
VITE_OCR_MODEL=glm-ocr

# 推理模型 → 留房推理
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4o-mini

# 审计 Embedding → V_q×V_book 寻址
VITE_EMBED_API_KEY=
VITE_EMBED_BASE_URL=https://api.openai.com/v1
VITE_EMBED_MODEL=text-embedding-3-small
