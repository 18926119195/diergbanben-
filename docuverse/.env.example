# Copy to .env.local for local defaults (UI「模型部署」可覆盖并写入 localStorage).
# Secrets: .env.local only (gitignored). On Vercel → Project → Environment Variables.

# ── 默认栈（与代码 defaultDualModelConfig 一致）──────────────────────────
# OCR：智谱 glm-ocr（代理注入 Key，勿把 ZHIPU_API_KEY 写进 VITE_*）
ZHIPU_API_KEY=
VITE_OCR_BASE_URL=/api/zhipu
VITE_OCR_MODEL=glm-ocr
# 仅当不用代理、直连智谱时才设（会进浏览器包，不推荐）:
# VITE_OCR_API_KEY=

# 推理 + 审计：同一硅基流动账号（Chat ≠ Embedding 模型名）
VITE_LLM_BASE_URL=https://api.siliconflow.cn/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Embedding 默认跟推理同 Base/Key；模型必须是 embedding（Flash 不能向量化）
# VITE_EMBED_BASE_URL=   # 省略则用 VITE_LLM_BASE_URL
# VITE_EMBED_API_KEY=    # 省略则用 VITE_LLM_API_KEY
VITE_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B

# Vercel 必配服务端变量：ZHIPU_API_KEY
# Vercel 构建时需带：VITE_LLM_API_KEY / VITE_LLM_* / VITE_EMBED_MODEL（与上相同即可）

# 外显演示：仅脱敏小字/隐藏 Pilot 部署面板，交互功能全开。开发全量：VITE_PUBLIC_DEMO=false
VITE_PUBLIC_DEMO=true
